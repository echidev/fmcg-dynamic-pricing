    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "======================================================================\n",
      "BUG FIX VERIFICATION\n",
      "======================================================================\n",
      "Features: 9 leakage-free features: ['day_of_week', 'week_of_year', 'month', 'quarter', 'day_of_month', 'is_weekend', 'is_month_start', 'is_month_end', 'avg_price_lag_1']\n",
      "LSTM Peak Capture: 29.0%\n",
      "CLS: Using .values + np.nan_to_num (no index mismatch)\n"
     ]
    }
   ],
   "source": [
    "# BUG FIX 2: Safe CLS/IHC calculation with proper array operations\n",
    "def calc_cls_safe(y_true, y_pred, avg_price_arr, margin):\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    avg_price = np.asarray(avg_price_arr, dtype=float)\n",
    "    avg_price = np.nan_to_num(avg_price, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    lost_sales = np.maximum(y_true - y_pred, 0)\n",
    "    cls = np.sum(lost_sales * avg_price * margin)\n",
    "    return cls\n",
    "\n",
    "def calc_ihc_safe(y_true, y_pred, avg_price_arr, cogs, holding_daily):\n",
    "    y_true = np.asarray(y_true, dtype=float)\n",
    "    y_pred = np.asarray(y_pred, dtype=float)\n",
    "    avg_price = np.asarray(avg_price_arr, dtype=float)\n",
    "    avg_price = np.nan_to_num(avg_price, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    excess = np.maximum(y_pred - y_true, 0)\n",
    "    ihc = np.sum(excess * avg_price * cogs * holding_daily)\n",
    "    return ihc\n",
    "\n",
    "def mape(y_true, y_pred):\n",
    "    mask = y_true != 0\n",
    "    if mask.sum() == 0:\n",
    "        return 0\n",
    "    return np.mean(np.abs((y_true[mask] - y_pred[mask]) / y_true[mask])) * 100\n",
    "\n",
    "def smape(y_true, y_pred):\n",
    "    y_true = np.array(y_true, dtype=float)\n",
    "    y_pred = np.array(y_pred, dtype=float)\n",
    "    denominator = (np.abs(y_true) + np.abs(y_pred)) / 2.0\n",
    "    mask = denominator != 0\n",
    "    if mask.sum() == 0:\n",
    "        return 0\n",
    "    return np.mean(np.abs(y_true[mask] - y_pred[mask]) / denominator[mask]) * 100\n",
    "\n",
    "def f1_zero_detection(y_true, y_pred):\n",
    "    y_true_binary = (y_true > 0).astype(int)\n",
    "    y_pred_binary = (y_pred > 0).astype(int)\n",
    "    tp = np.sum((y_pred_binary == 1) & (y_true_binary == 1))\n",
    "    fp = np.sum((y_pred_binary == 1) & (y_true_binary == 0))\n",
    "    fn = np.sum((y_pred_binary == 0) & (y_true_binary == 1))\n",
    "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n",
    "    return f1, precision, recall\n",
    "\n",
    "def per_product_metrics(df_eval, pred_col, baseline_col):\n",
    "    grouped = df_eval.groupby(\"stock_code_raw\")\n",
    "    results = []\n",
    "    for code, group in grouped:\n",
    "        y_true = group[\"demand_qty\"].values\n",
    "        y_pred = group[pred_col].values\n",
    "        y_base = group[baseline_col].values\n",
    "\n",
    "        mae = mean_absolute_error(y_true, y_pred)\n",
    "        rmse = np.sqrt(mean_squared_error(y_true, y_pred))\n",
    "        mape_val = mape(y_true, y_pred)\n",
    "        smape_val = smape(y_true, y_pred)\n",
    "        f1_val, prec_val, rec_val = f1_zero_detection(y_true, y_pred)\n",
    "\n",
    "        lost_sales = np.maximum(y_true - y_pred, 0)\n",
    "        excess_inventory = np.maximum(y_pred - y_true, 0)\n",
    "\n",
    "        # BUG FIX 2: .values + np.nan_to_num for safe calculation\n",
    "        avg_price = group[\"avg_price_lag_1\"].replace([np.inf, -np.inf], np.nan).fillna(0).values\n",
    "        avg_price = np.nan_to_num(avg_price, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "        cls = np.sum(lost_sales * avg_price * gross_margin)\n",
    "        ihc = np.sum(excess_inventory * avg_price * cogs_ratio * holding_cost_daily)\n",
    "\n",
    "        oos_rate = np.mean(y_pred < y_true) if len(y_true) else 0\n",
    "        demand_sum = y_true.sum()\n",
    "        inventory_avg = np.mean(y_pred) if len(y_pred) else 0\n",
    "        turnover = demand_sum / inventory_avg if inventory_avg > 0 else 0\n",
    "        ofr = (np.minimum(y_true, y_pred).sum() / demand_sum) if demand_sum > 0 else 0\n",
    "\n",
    "        mae_baseline = mean_absolute_error(y_true, y_base)\n",
    "        fva = (1 - (mae / mae_baseline)) * 100 if mae_baseline > 0 else 0\n",
    "\n",
    "        nonzero_mask = y_true > 0\n",
    "        if nonzero_mask.sum() > 0:\n",
    "            mae_nz = mean_absolute_error(y_true[nonzero_mask], y_pred[nonzero_mask])\n",
    "            rmse_nz = np.sqrt(mean_squared_error(y_true[nonzero_mask], y_pred[nonzero_mask]))\n",
    "            smape_nz = smape(y_true[nonzero_mask], y_pred[nonzero_mask])\n",
    "        else:\n",
    "            mae_nz = 0\n",
    "            rmse_nz = 0\n",
    "            smape_nz = 0\n",
    "\n",
    "        results.append({\n",
    "            \"stock_code\": code,\n",
    "            \"mae\": mae,\n",
    "            \"rmse\": rmse,\n",
    "            \"mape\": mape_val,\n",
    "            \"smape\": smape_val,\n",
    "            \"mae_nonzero\": mae_nz,\n",
    "            \"rmse_nonzero\": rmse_nz,\n",
    "            \"smape_nonzero\": smape_nz,\n",
    "            \"f1_zero\": f1_val,\n",
    "            \"precision_zero\": prec_val,\n",
    "            \"recall_zero\": rec_val,\n",
    "            \"cls\": cls,\n",
    "            \"ihc\": ihc,\n",
    "            \"oos_rate\": oos_rate,\n",
    "            \"turnover\": turnover,\n",
    "            \"ofr\": ofr,\n",
    "            \"fva\": fva,\n",
    "            \"total_qty\": demand_sum,\n",
    "            \"n_nonzero\": nonzero_mask.sum(),\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(results)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Direct (batch) prediction\n",
    "# ============================================================\n",
    "\n",
    "print(\"=== Direct Batch Prediction ===\")\n",
    "print(f\"Test set shape: {X_test.shape}\")\n",
    "print(f\"Features used: {len(feature_cols)} (leakage-free)\")\n",
    "\n",
    "print(\"Predicting XGBoost...\")\n",
    "xgb_preds = xgb_model.predict(X_test)\n",
    "\n",
    "print(\"Predicting LightGBM...\")\n",
    "lgbm_preds = lgbm_model.predict(X_test)\n",
    "\n",
    "print(\"Predicting CatBoost...\")\n",
    "cat_preds = cat_model.predict(X_test)\n",
    "\n",
    "print(\"Predicting Ridge...\")\n",
    "ridge_preds = ridge_model.predict(X_test)\n",
    "\n",
    "print(\"Predicting ElasticNet...\")\n",
    "elastic_preds = elastic_model.predict(X_test)\n",
    "\n",
    "print(f\"LSTM predictions: {lstm_preds_all.shape}\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Build evaluation DataFrame\n",
    "# ============================================================\n",
    "\n",
    "df_eval = df_test.copy()\n",
    "df_eval[\"xgb_pred\"] = xgb_preds\n",
    "df_eval[\"lgbm_pred\"] = lgbm_preds\n",
    "df_eval[\"cat_pred\"] = cat_preds\n",
    "df_eval[\"ridge_pred\"] = ridge_preds\n",
    "df_eval[\"elastic_pred\"] = elastic_preds\n",
    "df_eval[\"lstm_pred\"] = lstm_preds_all\n",
    "\n",
    "df_eval = df_eval.sort_values([\"stock_code_raw\", \"date\"]).reset_index(drop=True)\n",
    "df_eval[\"naive_pred\"] = df_eval.groupby(\"stock_code_raw\")[\"demand_qty\"].shift(1)\n",
    "df_eval[\"naive_pred\"] = df_eval[\"naive_pred\"].fillna(0)\n",
    "\n",
    "for code, group in df_eval.groupby(\"stock_code_raw\"):\n",
    "    first_idx = group.index[0]\n",
    "    if group.loc[first_idx, \"naive_pred\"] == 0:\n",
    "        last_train = df_train[df_train[\"stock_code_raw\"] == code][\"demand_qty\"].iloc[-1] if code in df_train[\"stock_code_raw\"].values else 0\n",
    "        df_eval.loc[first_idx, \"naive_pred\"] = last_train\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Peak Day Evaluation\n",
    "# ============================================================\n",
    "\n",
    "peak_mask = df_eval[\"demand_qty\"] > (df_eval[\"roll_mean_28\"] + 1.5 * df_eval[\"roll_std_28\"])\n",
    "\n",
    "y_peak = df_eval.loc[peak_mask, \"demand_qty\"].values\n",
    "xgb_peak = df_eval.loc[peak_mask, \"xgb_pred\"].values\n",
    "lgbm_peak = df_eval.loc[peak_mask, \"lgbm_pred\"].values\n",
    "avg_price_peak = df_eval.loc[peak_mask, \"avg_price_lag_1\"].replace([np.inf, -np.inf], np.nan).fillna(0).values\n",
    "avg_price_peak = np.nan_to_num(avg_price_peak, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "\n",
    "def evaluate_peak_days(y_true_peak, y_pred_peak, avg_price_peak_arr):\n",
    "    y_true_peak = np.asarray(y_true_peak, dtype=float)\n",
    "    y_pred_peak = np.asarray(y_pred_peak, dtype=float)\n",
    "    avg_price_p = np.asarray(avg_price_peak_arr, dtype=float)\n",
    "    avg_price_p = np.nan_to_num(avg_price_p, nan=0.0, posinf=0.0, neginf=0.0)\n",
    "\n",
    "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
    "        total_true = np.sum(y_true_peak)\n",
    "        total_pred = np.sum(y_pred_peak)\n",
    "        peak_capture = (total_pred / total_true) * 100 if total_true > 0 else 0\n",
    "        wape = (np.sum(np.abs(y_true_peak - y_pred_peak)) / total_true) if total_true > 0 else 0\n",
    "        bias = (np.sum(y_pred_peak - y_true_peak) / total_true) * 100 if total_true > 0 else 0\n",
    "        ofr = (np.sum(np.minimum(y_true_peak, y_pred_peak)) / total_true) * 100 if total_true > 0 else 0\n",
    "        cls = calc_cls_safe(y_true_peak, y_pred_peak, avg_price_p, 0.20)\n",
    "\n",
    "    return {\n",
    "        \"Peak Capture Ratio (%)\": peak_capture,\n",
    "        \"WAPE\": wape,\n",
    "        \"Forecast Bias (%)\": bias,\n",
    "        \"Peak OFR (%)\": ofr,\n",
    "        \"Peak CLS\": cls,\n",
    "    }\n",
    "\n",
    "print(\"\\\\n=== Peak Day Metrics ===\")\n",
    "peak_xgb = evaluate_peak_days(y_peak, xgb_peak, avg_price_peak)\n",
    "peak_lgbm = evaluate_peak_days(y_peak, lgbm_peak, avg_price_peak)\n",
    "peak_cat = evaluate_peak_days(y_peak, df_eval.loc[peak_mask, \"cat_pred\"].values, avg_price_peak)\n",
    "peak_ridge = evaluate_peak_days(y_peak, df_eval.loc[peak_mask, \"ridge_pred\"].values, avg_price_peak)\n",
    "peak_elastic = evaluate_peak_days(y_peak, df_eval.loc[peak_mask, \"elastic_pred\"].values, avg_price_peak)\n",
    "peak_lstm = evaluate_peak_days(\n",
    "    df_eval.loc[peak_mask, \"demand_qty\"].values,\n",
    "    df_eval.loc[peak_mask, \"lstm_pred\"].values,\n",
    "    df_eval.loc[peak_mask, \"avg_price_lag_1\"].replace([np.inf, -np.inf], np.nan).fillna(0).values,\n",
    ")\n",
    "\n",
    "peak_metrics_df = pd.DataFrame([\n",
    "    {\"Model\": \"xgboost\", **peak_xgb},\n",
    "    {\"Model\": \"lightgbm\", **peak_lgbm},\n",
    "    {\"Model\": \"catboost\", **peak_cat},\n",
    "    {\"Model\": \"ridge\", **peak_ridge},\n",
    "    {\"Model\": \"elasticnet\", **peak_elastic},\n",
    "    {\"Model\": \"lstm\", **peak_lstm},\n",
    "])\n",
    "\n",
    "peak_metrics_df = peak_metrics_df[[\n",
    "    \"Model\", \"Peak Capture Ratio (%)\", \"WAPE\",\n",
    "    \"Forecast Bias (%)\", \"Peak OFR (%)\", \"Peak CLS\",\n",
    "]]\n",
    "print(peak_metrics_df)\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# General Metrics\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\\\n=== Per-Product Metrics ===\")\n",
    "metrics_xgb = per_product_metrics(df_eval, pred_col=\"xgb_pred\", baseline_col=\"naive_pred\")\n",
    "metrics_lgbm = per_product_metrics(df_eval, pred_col=\"lgbm_pred\", baseline_col=\"naive_pred\")\n",
    "metrics_cat = per_product_metrics(df_eval, pred_col=\"cat_pred\", baseline_col=\"naive_pred\")\n",
    "metrics_ridge = per_product_metrics(df_eval, pred_col=\"ridge_pred\", baseline_col=\"naive_pred\")\n",
    "metrics_elastic = per_product_metrics(df_eval, pred_col=\"elastic_pred\", baseline_col=\"naive_pred\")\n",
    "metrics_lstm = per_product_metrics(df_eval, pred_col=\"lstm_pred\", baseline_col=\"naive_pred\")\n",
    "\n",
    "def weighted_summary(metrics_df):\n",
    "    grand_total = metrics_df[\"total_qty\"].sum()\n",
    "    weights = metrics_df[\"total_qty\"] / grand_total if grand_total > 0 else 0\n",
    "    weighted = {}\n",
    "    for col in [\"mae\", \"rmse\", \"mape\", \"smape\", \"mae_nonzero\", \"rmse_nonzero\", \"smape_nonzero\", \"f1_zero\", \"cls\", \"ihc\", \"oos_rate\", \"turnover\", \"ofr\", \"fva\"]:\n",
    "        weighted[col] = (metrics_df[col] * weights).sum()\n",
    "    return pd.DataFrame([weighted])\n",
    "\n",
    "summary_xgb = weighted_summary(metrics_xgb).assign(model=\"xgboost\")\n",
    "summary_lgbm = weighted_summary(metrics_lgbm).assign(model=\"lightgbm\")\n",
    "summary_cat = weighted_summary(metrics_cat).assign(model=\"catboost\")\n",
    "summary_ridge = weighted_summary(metrics_ridge).assign(model=\"ridge\")\n",
    "summary_elastic = weighted_summary(metrics_elastic).assign(model=\"elasticnet\")\n",
    "summary_lstm = weighted_summary(metrics_lstm).assign(model=\"lstm\")\n",
    "\n",
    "general_metrics_df = pd.concat([\n",
    "    summary_xgb, summary_lgbm, summary_cat,\n",
    "    summary_ridge, summary_elastic, summary_lstm,\n",
    "], ignore_index=True)[[\"model\", \"mae\", \"rmse\", \"mape\", \"smape\", \"mae_nonzero\", \"rmse_nonzero\", \"smape_nonzero\", \"f1_zero\", \"cls\", \"ihc\", \"oos_rate\", \"turnover\", \"ofr\", \"fva\"]]\n",
    "\n",
    "print(\"\\\\n=== Weighted Summary Metrics ===\")\n",
    "\n",
    "def style_metric_table(df, title):\n",
    "    styled = df.copy()\n",
    "    for col in styled.columns:\n",
    "        if col == \"model\" or col == \"Model\":\n",
    "            continue\n",
    "        if \"fva\" in col.lower() or \"rate\" in col.lower() or \"capture\" in col.lower() or \"bias\" in col.lower() or \"ofr\" in col.lower():\n",
    "            styled[col] = styled[col].round(2)\n",
    "        elif \"cls\" in col.lower() or \"ihc\" in col.lower():\n",
    "            styled[col] = styled[col].round(2)\n",
    "        else:\n",
    "            styled[col] = styled[col].round(4)\n",
    "    s = styled.style.set_caption(title).set_table_styles([\n",
    "        {'selector': 'caption', 'props': [('font-size', '16px'), ('font-weight', 'bold')]},\n",
    "        {'selector': 'th', 'props': [('background-color', '#f0f0f0'), ('font-weight', 'bold')]},\n",
    "    ])\n",
    "    return s\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"WEIGHTED SUMMARY METRICS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "print(\"\\n1. ACCURACY METRICS\")\n",
    "acc_df = general_metrics_df[[\"model\", \"mae\", \"rmse\", \"mape\", \"smape\"]].copy()\n",
    "acc_df.columns = [\"Model\", \"MAE\", \"RMSE\", \"MAPE (%)\", \"SMAPE (%)\"]\n",
    "display(style_metric_table(acc_df, \"Accuracy\"))\n",
    "\n",
    "print(\"\\n2. NON-ZERO DEMAND METRICS\")\n",
    "nz_df = general_metrics_df[[\"model\", \"mae_nonzero\", \"rmse_nonzero\", \"smape_nonzero\"]].copy()\n",
    "nz_df.columns = [\"Model\", \"MAE\", \"RMSE\", \"SMAPE (%)\"]\n",
    "display(style_metric_table(nz_df, \"Non-Zero Demand\"))\n",
    "\n",
    "print(\"\\n3. ZERO DETECTION (F1 Score)\")\n",
    "f1_df = general_metrics_df[[\"model\", \"f1_zero\"]].copy()\n",
    "f1_df.columns = [\"Model\", \"F1\"]\n",
    "f1_styled = f1_df.style.format({\"F1\": \"{:.4f}\"}).background_gradient(cmap=\"Greens\", subset=[\"F1\"])\n",
    "display(f1_styled)\n",
    "\n",
    "print(\"\\n4. BUSINESS METRICS\")\n",
    "biz_df = general_metrics_df[[\"model\", \"cls\", \"ihc\", \"oos_rate\", \"turnover\", \"ofr\"]].copy()\n",
    "biz_df.columns = [\"Model\", \"CLS ($)\", \"IHC ($)\", \"OOS Rate\", \"Turnover\", \"OFR\"]\n",
    "display(style_metric_table(biz_df, \"Business\"))\n",
    "\n",
    "print(\"\\n5. FORECAST VALUE ADD (vs Naive)\")\n",
    "fva_df = general_metrics_df[[\"model\", \"fva\"]].copy()\n",
    "fva_df.columns = [\"Model\", \"FVA (%)\"]\n",
    "fva_styled = fva_df.style.format({\"FVA (%)\": \"{:.2f}\"}).map(\n",
    "    lambda v: \"color: green\" if v > 0 else \"color: red\", subset=[\"FVA (%)\"]\n",
    ")\n",
    "display(fva_styled)\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"MODEL RANKING (by SMAPE - lower is better)\")\n",
    "print(\"=\"*70)\n",
    "ranking_df = general_metrics_df[[\"model\", \"smape\", \"mae_nonzero\", \"f1_zero\"]].copy()\n",
    "ranking_df.columns = [\"Model\", \"SMAPE\", \"MAE (nz)\", \"F1\"]\n",
    "ranking_df = ranking_df.sort_values(\"SMAPE\").reset_index(drop=True)\n",
    "ranking_df.insert(0, \"Rank\", range(1, len(ranking_df) + 1))\n",
    "rank_styled = ranking_df.style.format({\"SMAPE\": \"{:.4f}\", \"MAE (nz)\": \"{:.4f}\", \"F1\": \"{:.4f}\"}).highlight_min(subset=[\"SMAPE\", \"MAE (nz)\"], color=\"lightgreen\").highlight_max(subset=[\"F1\"], color=\"lightgreen\")\n",
    "display(rank_styled)\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"BUG FIX VERIFICATION\")\n",
    "print(\"=\"*70)\n",
    "print(f\"Features: {len(feature_cols)} leakage-free features: {feature_cols}\")\n",
    "print(f\"LSTM Peak Capture: {peak_lstm['Peak Capture Ratio (%)']:.1f}%\")\n",
    "print(\"CLS: Using .values + np.nan_to_num (no index mismatch)\")\n"
   ]
  },
