  {
   "cell_type": "markdown",
   "id": "8a9f4209",
   "metadata": {},
   "source": [
    "## LSTM Baseline (TensorFlow/Keras)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 86,
   "id": "fe162f95",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "LSTM sequences: train=(3316234, 7, 9), test=(108652, 7, 9)\n",
      "LSTM predictions mapped: (141720,)\n",
      "LSTM stats: mean=13.1946, std=18.7674\n"
     ]
    }
   ],
   "source": [
    "time_steps = 7\n",
    "\n",
    "# BUG FIX 3: Scaler ONLY fit on train\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "# BUG FIX 3: Per-stock-code sequence grouping\n",
    "def create_sequences_per_product(X_scaled, y_values, df_sorted, steps):\n",
    "    Xs, ys = [], []\n",
    "    for code, group in df_sorted.groupby(\"stock_code_raw\"):\n",
    "        group_len = len(group)\n",
    "        if group_len <= steps:\n",
    "            continue\n",
    "        idx_list = group.index.tolist()\n",
    "        X_group = X_scaled[idx_list]\n",
    "        y_group = y_values[idx_list]\n",
    "        for i in range(len(X_group) - steps):\n",
    "            Xs.append(X_group[i:i + steps])\n",
    "            ys.append(y_group[i + steps])\n",
    "    return np.array(Xs), np.array(ys)\n",
    "\n",
    "df_train_sorted = df_train.sort_values([\"stock_code_raw\", \"date\"]).reset_index(drop=True)\n",
    "df_test_sorted = df_test.sort_values([\"stock_code_raw\", \"date\"]).reset_index(drop=True)\n",
    "\n",
    "X_train_seq, y_train_seq = create_sequences_per_product(\n",
    "    X_train_scaled, y_train.values, df_train_sorted, time_steps)\n",
    "X_test_seq, y_test_seq = create_sequences_per_product(\n",
    "    X_test_scaled, y_test.values, df_test_sorted, time_steps)\n",
    "\n",
    "print(f\"LSTM sequences: train={X_train_seq.shape}, test={X_test_seq.shape}\")\n",
    "\n",
    "# BUG FIX 3: Better architecture with Dropout\n",
    "lstm_model = Sequential([\n",
    "    LSTM(64, input_shape=(time_steps, X_train_seq.shape[2]), return_sequences=True),\n",
    "    Dropout(0.2),\n",
    "    LSTM(32),\n",
    "    Dropout(0.2),\n",
    "    Dense(1),\n",
    "])\n",
    "lstm_model.compile(optimizer=\"adam\", loss=\"mae\")\n",
    "lstm_model.fit(X_train_seq, y_train_seq, epochs=20, batch_size=64, verbose=0)\n",
    "\n",
    "# Map predictions back to original test rows\n",
    "lstm_preds_flat = lstm_model.predict(X_test_seq, verbose=0).flatten()\n",
    "lstm_preds_all = np.zeros(len(df_test_sorted))\n",
    "\n",
    "seq_idx = 0\n",
    "for code, group in df_test_sorted.groupby(\"stock_code_raw\"):\n",
    "    group_len = len(group)\n",
    "    idx_list = group.index.tolist()\n",
    "    if group_len <= time_steps:\n",
    "        fallback = df_train[df_train[\"stock_code_raw\"] == code][target_col].mean()\n",
    "        lstm_preds_all[idx_list] = fallback if not np.isnan(fallback) else 0\n",
    "        continue\n",
    "    n_preds = group_len - time_steps\n",
    "    lstm_preds_all[idx_list[:time_steps]] = group[\"lag_1\"].fillna(0).values[:time_steps]\n",
    "    lstm_preds_all[idx_list[time_steps:]] = lstm_preds_flat[seq_idx:seq_idx + n_preds]\n",
    "    seq_idx += n_preds\n",
    "\n",
    "print(f\"LSTM predictions mapped: {lstm_preds_all.shape}\")\n",
    "print(f\"LSTM stats: mean={lstm_preds_all.mean():.4f}, std={lstm_preds_all.std():.4f}\")\n"
   ]
  },
