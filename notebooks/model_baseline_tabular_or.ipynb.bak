    "data_path = \"../data/transform/online_retail_daily_product_tabular.csv\"\n",
    "df = pd.read_csv(data_path)\n",
    "df[\"date\"] = pd.to_datetime(df[\"date\"])\n",
    "df.head()"
   ]
  },
