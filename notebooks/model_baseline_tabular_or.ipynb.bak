  {
   "cell_type": "markdown",
   "id": "7148a424",
   "metadata": {},
   "source": [
    "## Train/Test Split (Time-based)\n",
    "Split per product: train = all dates before last 30 days, test = last 30 days."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 79,
   "id": "1883baaf",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Global cutoff: 2011-11-09 00:00:00\n",
      "Train shape: (3349316, 28) Test shape: (141720, 28)\n"
     ]
    }
   ],
   "source": [
    "horizon_days = 30\n",
    "df = df.sort_values([\"stock_code\", \"date\"]).reset_index(drop=True)\n",
    "\n",
    "global_max_date = df[\"date\"].max()\n",
    "cutoff = global_max_date - pd.Timedelta(days=horizon_days)\n",
    "\n",
    "train_mask = df[\"date\"] <= cutoff\n",
    "test_mask = df[\"date\"] > cutoff\n",
    "\n",
    "df_train = df.loc[train_mask].copy()\n",
    "df_test = df.loc[test_mask].copy()\n",
    "\n",
    "print(\"Global cutoff:\", cutoff)\n",
    "print(\"Train shape:\", df_train.shape, \"Test shape:\", df_test.shape)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 80,
   "id": "568d44b5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['stock_code', 'date', 'demand_qty', 'revenue', 'num_invoices',\n",
       "       'day_of_week', 'week_of_year', 'month', 'quarter', 'day_of_month',\n",
       "       'is_weekend', 'is_month_start', 'is_month_end', 'lag_1', 'lag_7',\n",
       "       'lag_14', 'lag_28', 'roll_mean_7', 'roll_mean_14', 'roll_mean_28',\n",
       "       'roll_std_7', 'roll_std_28', 'diff_1', 'diff_7', 'avg_price',\n",
       "       'product_popularity', 'product_revenue_share', 'product_lifecycle_age'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 80,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.columns"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "70ae8a68",
   "metadata": {},
   "source": [
    "## Feature Preparation\n",
    "- Label encode `stock_code`\n",
    "- Impute NaN from lag/rolling with 0"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 81,
   "id": "96d84e1d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Features (9) - leakage-free for batch prediction:\n",
      "  [OK] day_of_week\n",
      "  [OK] week_of_year\n",
      "  [OK] month\n",
      "  [OK] quarter\n",
      "  [OK] day_of_month\n",
      "  [OK] is_weekend\n",
      "  [OK] is_month_start\n",
      "  [OK] is_month_end\n",
      "  [OK] avg_price_lag_1\n",
      "\n",
      "Dropped leakage features (contain actual test demand):\n",
      "  [X] lag_1\n",
      "  [X] lag_7\n",
      "  [X] lag_14\n",
      "  [X] lag_28\n",
      "  [X] diff_1\n",
      "  [X] diff_7\n",
      "  [X] roll_mean_7\n",
      "  [X] roll_mean_14\n",
      "  [X] roll_mean_28\n",
      "  [X] roll_std_7\n",
      "  [X] roll_std_28\n",
      "\n",
      "X_train: (3349316, 9), X_test: (141720, 9)\n",
      "Zero-demand: train=85.2%, test=75.0%\n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "((3349316, 9), (141720, 9))"
      ]
     },
     "execution_count": 81,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "target_col = \"demand_qty\"\n",
    "\n",
    "df_train[\"stock_code_raw\"] = df_train[\"stock_code\"]\n",
    "df_test[\"stock_code_raw\"] = df_test[\"stock_code\"]\n",
    "\n",
    "# BUG FIX 1: avg_price_lag_1 from TRAIN only\n",
    "df_train[\"avg_price_lag_1\"] = df_train.groupby(\"stock_code_raw\")[\"avg_price\"].shift(1)\n",
    "last_train_price = df_train.groupby(\"stock_code_raw\")[\"avg_price\"].last()\n",
    "df_test[\"avg_price_lag_1\"] = df_test[\"stock_code_raw\"].map(last_train_price)\n",
    "df_train[\"avg_price_lag_1\"] = df_train[\"avg_price_lag_1\"].replace([np.inf, -np.inf], np.nan).fillna(0)\n",
    "df_test[\"avg_price_lag_1\"] = df_test[\"avg_price_lag_1\"].replace([np.inf, -np.inf], np.nan).fillna(0)\n",
    "\n",
    "# Drop product features (computed from full dataset = leakage)\n",
    "for col in [\"product_popularity\", \"product_revenue_share\", \"product_lifecycle_age\", \"product_revenue_total\", \"first_sale_date\", \"stock_code\"]:\n",
    "    if col in df_train.columns:\n",
    "        df_train = df_train.drop(columns=[col])\n",
    "    if col in df_test.columns:\n",
    "        df_test = df_test.drop(columns=[col])\n",
    "\n",
    "# BUG FIX 1: Remove ALL time-dependent demand features from batch prediction\n",
    "# For 30-day direct batch prediction, lag/diff/roll features on test set\n",
    "# contain actual future demand values -> TARGET LEAKAGE\n",
    "LEAKAGE_FEATURES = [\n",
    "    \"lag_1\", \"lag_7\", \"lag_14\", \"lag_28\",\n",
    "    \"diff_1\", \"diff_7\",\n",
    "    \"roll_mean_7\", \"roll_mean_14\", \"roll_mean_28\",\n",
    "    \"roll_std_7\", \"roll_std_28\",\n",
    "]\n",
    "\n",
    "SAFE_FEATURES = [\n",
    "    \"day_of_week\", \"week_of_year\", \"month\", \"quarter\", \"day_of_month\",\n",
    "    \"is_weekend\", \"is_month_start\", \"is_month_end\",\n",
    "    \"avg_price_lag_1\",\n",
    "]\n",
    "\n",
    "feature_cols = [col for col in SAFE_FEATURES if col in df_train.columns]\n",
    "\n",
    "print(f\"Features ({len(feature_cols)}) - leakage-free for batch prediction:\")\n",
    "for col in feature_cols:\n",
    "    print(f\"  [OK] {col}\")\n",
    "\n",
    "print(f\"\\nDropped leakage features (contain actual test demand):\")\n",
    "for col in LEAKAGE_FEATURES:\n",
    "    if col in df_train.columns:\n",
    "        print(f\"  [X] {col}\")\n",
    "\n",
    "X_train = df_train[feature_cols].copy()\n",
    "y_train = df_train[target_col].copy()\n",
    "X_test = df_test[feature_cols].copy()\n",
    "y_test = df_test[target_col].copy()\n",
    "\n",
    "X_train = X_train.fillna(0)\n",
    "X_test = X_test.fillna(0)\n",
    "\n",
    "print(f\"\\nX_train: {X_train.shape}, X_test: {X_test.shape}\")\n",
    "print(f\"Zero-demand: train={(y_train==0).mean()*100:.1f}%, test={(y_test==0).mean()*100:.1f}%\")\n",
    "\n",
    "X_train.shape, X_test.shape\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "4a7fdc58",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['day_of_week', 'week_of_year', 'month', 'quarter', 'day_of_month',\n",
       "       'is_weekend', 'is_month_start', 'is_month_end', 'avg_price_lag_1'],\n",
       "      dtype='object')"
      ]
     },
     "execution_count": 82,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "X_train.columns"
   ]
  },
